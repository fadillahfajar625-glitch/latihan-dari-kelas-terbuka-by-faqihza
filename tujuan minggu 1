def hitung_semua(angka1,angka2,pilihan):
    if pilihan == '+':
        return angka1 + angka2, '+'
    elif pilihan == '-':
        return angka1 - angka2, '-'
    elif pilihan == '*' or pilihan == 'X'.lower():
        return angka1 * angka2, '*'
    elif pilihan == '%':
        return angka1 % angka2, '%'
    elif pilihan == '**':
        return angka1 ** angka2, '**'
    elif pilihan == '//':
        if angka2 == 0:
            return 'angka tidak dibisa difloor_division dari 0','//'
        
        
        return angka1 // angka2, '//'
    elif pilihan == '/':
        if angka2 == 0 :
            return 'angka tidak dibisa dibagi 0','/'
        return angka1 / angka2 , '/'
    else:
        return None,None
