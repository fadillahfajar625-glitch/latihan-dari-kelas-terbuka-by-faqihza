import os as wey
def header():
    wey.system('cls')
    print(f'{'program menghitung Luas':^40}')
    print(f'{'Dan keliling Persegi Panjang':^40}')
    print(f'{'-'*40:^40}')
def input_user():
    lebar = int(input('masukkan angka kedalam sini : '))
    panjang = int(input('masukkan angka kedalam sini : '))
    return lebar,panjang
def luas(lebar,panjang):
    return lebar*panjang
def keliling(lebar,panjang):
    return 2*(lebar+panjang)
while True:
    header()
    lebar,panjang = input_user()#dia memiliki 2 variabel yang menyimpan 2 nilai.
    lu4s = luas(lebar,panjang)
    kelil1ng = keliling(lebar,panjang)
    print(f'hasil perhitungan luas = {lu4s}')
    print(f'hasil perhitungan keliling = {kelil1ng}')
    lanjut = input('apakah anda ingin berhenti? : ')
